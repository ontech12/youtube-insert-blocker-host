Windows Registry Editor Version 5.00

; Force-install from GitHub Pages for Chrome and Edge.
; Unpins the icon and blocks the extensions page so kids are less likely to see it.
; They can still find it if they can open chrome://extensions by some other path.
; Run as Administrator, then fully quit and reopen Chrome/Edge.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist]
"1"="jhnfgifegdmhefpkbpnefelblhgipfjf;https://ontech12.github.io/youtube-insert-blocker-host/updates.xml"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallSources]
"1"="https://ontech12.github.io/youtube-insert-blocker-host/*"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"ExtensionSettings"="{\"jhnfgifegdmhefpkbpnefelblhgipfjf\":{\"installation_mode\":\"force_installed\",\"update_url\":\"https://ontech12.github.io/youtube-insert-blocker-host/updates.xml\",\"toolbar_pin\":\"default_unpinned\"}}"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\URLBlocklist]
"1"="chrome://extensions"
"2"="chrome://extensions-internals"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallForcelist]
"1"="jhnfgifegdmhefpkbpnefelblhgipfjf;https://ontech12.github.io/youtube-insert-blocker-host/updates.xml"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallSources]
"1"="https://ontech12.github.io/youtube-insert-blocker-host/*"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"ExtensionSettings"="{\"jhnfgifegdmhefpkbpnefelblhgipfjf\":{\"installation_mode\":\"force_installed\",\"update_url\":\"https://ontech12.github.io/youtube-insert-blocker-host/updates.xml\",\"toolbar_pin\":\"default_unpinned\"}}"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\URLBlocklist]
"1"="edge://extensions"
"2"="edge://extensions-internals"
